---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../Breadcrumb.astro';
import { getLocalizedPath, type Lang } from '../../i18n/ui';
import { getAboutContent } from '../../i18n/content/about';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = getAboutContent(lang);

const BOOKING_URL = 'https://cal.eu/alexpruteanu';
const EMAIL = 'alexpruteanu@hotmail.com';
const LINKEDIN_URL = 'https://linkedin.com/in/alexandru-prt';
const GITHUB_URL = 'https://github.com/xander1421';

// JSON-LD structured data for Person schema (recruiters + rich results)
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Alexandru Pruteanu",
  "alternateName": "Alex Pruteanu",
  "url": "https://www.alexpruteanu.cloud",
  "image": "https://www.alexpruteanu.cloud/og-image.png",
  "jobTitle": "DevOps Engineer & Cloud Cost Consultant",
  "worksFor": {
    "@type": "Organization",
    "name": "Yopeso"
  },
  "sameAs": [
    GITHUB_URL,
    LINKEDIN_URL,
    "https://www.alexpruteanu.cloud"
  ],
  "email": EMAIL,
  "knowsAbout": [
    "DevOps",
    "Cloud Cost Optimization",
    "FinOps",
    "Cloud Infrastructure",
    "AWS",
    "Google Cloud Platform",
    "Kubernetes",
    "Docker",
    "Terraform",
    "Infrastructure as Code",
    "CI/CD",
    "Jenkins",
    "GitHub Actions",
    "Ansible",
    "Helm",
    "Site Reliability Engineering",
    "Monitoring",
    "Observability",
    "Python",
    "Bash",
    "PostgreSQL",
    "Redis",
    "Security",
    "IAM",
    "RBAC",
    "Secrets Management",
    "SSL/TLS",
    "Encryption"
  ],
  "knowsLanguage": [
    { "@type": "Language", "name": "Romanian", "alternateName": "ro" },
    { "@type": "Language", "name": "English", "alternateName": "en" },
    { "@type": "Language", "name": "Portuguese", "alternateName": "pt" },
    { "@type": "Language", "name": "Russian", "alternateName": "ru" }
  ]
};
---

<BaseLayout title={c.metaTitle} description={c.metaDescription} localized>
  <!-- JSON-LD Schema for Person -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />

  <div class="about-container">
    <Breadcrumb items={[{ label: c.breadcrumbHome, href: getLocalizedPath('/', lang) }, { label: c.breadcrumbAbout }]} />

    <header class="about-header">
      <h1>{c.h1}</h1>
      <p class="header-subtitle">{c.headerSubtitle}</p>

      <div class="hero-cta">
        <a href={BOOKING_URL} class="cta-button" target="_blank" rel="noopener">{c.ctaBookCall}</a>
        <span class="cta-note">{c.ctaBookNote}</span>
      </div>

      <div class="social-links">
        <a href={GITHUB_URL} target="_blank" rel="noopener">{c.socialGithub}</a>
        <a href={LINKEDIN_URL} target="_blank" rel="noopener">{c.socialLinkedin}</a>
        <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
      </div>
    </header>

    <section class="do-section">
      <h2>{c.doHeading}</h2>
      <div class="do-grid">
        <div class="do-card">
          <h3>{c.doCard1Title}</h3>
          <p>{c.doCard1Body}</p>
        </div>
        <div class="do-card">
          <h3>{c.doCard2Title}</h3>
          <p>{c.doCard2Body}</p>
        </div>
        <div class="do-card">
          <h3>{c.doCard3Title}</h3>
          <p>{c.doCard3Body}</p>
        </div>
      </div>
      <p class="section-link">
        <a href={getLocalizedPath('/services', lang)}>{c.doServicesLink}</a>
      </p>
    </section>

    <section class="proof-section">
      <h2>{c.proofHeading}</h2>
      <div class="proof-item">
        <h3>{c.proofChatterTitle}</h3>
        <p>{c.proofChatterBody}</p>
        <a class="proof-link" href={getLocalizedPath('/projects/chatter', lang)}>{c.proofChatterLink}</a>
      </div>
      <div class="proof-item">
        <h3>{c.proofNumbersTitle}</h3>
        <p>{c.proofNumbersBody}</p>
      </div>
      <div class="proof-item">
        <h3>{c.proofBlogTitle}</h3>
        <p>{c.proofBlogBody}</p>
        <a class="proof-link" href={getLocalizedPath('/blog', lang)}>{c.proofBlogLink}</a>
      </div>
    </section>

    <section class="timeline-section">
      <h2>{c.timelineHeading}</h2>
      <p class="timeline-intro">{c.timelineIntro}</p>

      {c.jobs.map((job) => (
        <div class="job">
          <div class="job-header">
            <h3>{job.company}</h3>
            <span class="period">{job.period}</span>
          </div>
          <p class="job-summary">{job.summary}</p>
          <p class="tech-stack"><strong>{c.experienceTechLabel}</strong> {job.tech}</p>
        </div>
      ))}

      <p class="timeline-earlier">{c.timelineEarlier}</p>
      <p class="section-link">
        <a href={LINKEDIN_URL} target="_blank" rel="noopener">{c.timelineLinkedin}</a>
      </p>
    </section>

    <section class="work-section">
      <h2>{c.workHeading}</h2>
      <div class="do-grid">
        <div class="do-card">
          <h3>{c.value1Title}</h3>
          <p>{c.value1Body}</p>
        </div>
        <div class="do-card">
          <h3>{c.value2Title}</h3>
          <p>{c.value2Body}</p>
        </div>
        <div class="do-card">
          <h3>{c.value3Title}</h3>
          <p>{c.value3Body}</p>
        </div>
      </div>
      <p class="languages-line">{c.languagesLine}</p>
    </section>

    <section class="cta-section">
      <h2>{c.ctaHeading}</h2>
      <p>{c.ctaText}</p>
      <div class="cta-buttons">
        <a href={BOOKING_URL} class="cta-button" target="_blank" rel="noopener">{c.ctaBook}</a>
        <a href={`mailto:${EMAIL}`} class="cta-button secondary">{c.ctaEmail}</a>
        <a href={LINKEDIN_URL} class="cta-button secondary" target="_blank" rel="noopener">{c.ctaLinkedinBtn}</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .about-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  .about-header {
    text-align: center;
    margin-bottom: 4rem;
    padding-top: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 2px solid rgba(0, 255, 204, 0.2);
  }

  .about-header h1 {
    font-size: 3rem;
    margin-bottom: 1.2rem;
    color: var(--color-primary);
  }

  .header-subtitle {
    font-size: 1.2rem;
    line-height: 1.7;
    color: var(--color-text);
    max-width: 42rem;
    margin: 0 auto 2rem;
  }

  .hero-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 2rem;
  }

  .cta-note {
    color: var(--color-text-dim);
    font-family: 'Share Tech Mono', monospace;
    font-size: 0.9rem;
  }

  .social-links {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .social-links a {
    color: var(--color-primary);
    text-decoration: none;
    font-family: 'Share Tech Mono', monospace;
    font-size: 0.95rem;
    border-bottom: 1px solid rgba(0, 255, 204, 0.3);
    transition: border-color 0.3s ease;
  }

  .social-links a:hover {
    border-color: var(--color-primary);
  }

  section {
    margin-bottom: 4.5rem;
  }

  section h2 {
    font-size: 2rem;
    color: var(--color-primary);
    margin-bottom: 2rem;
    border-bottom: 2px solid rgba(0, 255, 204, 0.2);
    padding-bottom: 0.8rem;
  }

  .do-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  .do-card {
    padding: 1.5rem;
    border-radius: 8px;
    background: rgba(0, 255, 204, 0.03);
    border: 1px solid rgba(0, 255, 204, 0.25);
    transition: all 0.3s ease;
  }

  .do-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-primary);
  }

  .do-card h3 {
    font-size: 1.15rem;
    color: var(--color-primary);
    margin: 0 0 0.8rem 0;
  }

  .do-card p {
    color: var(--color-text);
    line-height: 1.7;
    margin: 0;
  }

  .section-link {
    margin-top: 1.5rem;
    text-align: right;
  }

  .section-link a,
  .proof-link {
    color: var(--color-primary);
    text-decoration: none;
    font-family: 'Share Tech Mono', monospace;
    border-bottom: 1px solid rgba(0, 255, 204, 0.3);
    transition: border-color 0.3s ease;
  }

  .section-link a:hover,
  .proof-link:hover {
    border-color: var(--color-primary);
  }

  .proof-item {
    margin-bottom: 2.5rem;
    padding: 1.5rem 2rem;
    background: rgba(0, 255, 204, 0.03);
    border-left: 4px solid var(--color-primary);
  }

  .proof-item h3 {
    font-size: 1.2rem;
    color: var(--color-text);
    margin: 0 0 0.8rem 0;
  }

  .proof-item p {
    line-height: 1.8;
    color: var(--color-text);
    margin: 0 0 0.8rem 0;
  }

  .timeline-intro {
    color: var(--color-text-dim);
    margin-bottom: 2rem;
  }

  .job {
    margin-bottom: 2.2rem;
    padding-bottom: 1.8rem;
    border-bottom: 1px solid rgba(0, 255, 204, 0.1);
  }

  .job-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    margin-bottom: 0.8rem;
  }

  .job-header h3 {
    font-size: 1.2rem;
    color: var(--color-primary);
    margin: 0;
  }

  .period {
    font-family: 'Share Tech Mono', monospace;
    color: var(--color-text-dim);
    font-size: 0.95rem;
    white-space: nowrap;
  }

  .job-summary {
    line-height: 1.7;
    color: var(--color-text);
    margin: 0 0 0.8rem 0;
  }

  .tech-stack {
    font-size: 0.9rem;
    color: var(--color-text-dim);
    font-family: 'Share Tech Mono', monospace;
    margin: 0;
  }

  .tech-stack strong {
    color: var(--color-primary);
  }

  .timeline-earlier {
    color: var(--color-text-dim);
    line-height: 1.7;
    margin-top: 1.5rem;
  }

  .languages-line {
    margin-top: 2rem;
    color: var(--color-text-dim);
    font-family: 'Share Tech Mono', monospace;
    font-size: 0.95rem;
    text-align: center;
  }

  .cta-section {
    text-align: center;
    padding: 3.5rem 2rem;
    background: rgba(0, 255, 204, 0.03);
    border: 2px solid rgba(0, 255, 204, 0.2);
    margin-top: 4rem;
  }

  .cta-section h2 {
    border: none;
    margin-bottom: 1rem;
  }

  .cta-section p {
    color: var(--color-text-dim);
    margin-bottom: 2.5rem;
    font-size: 1.1rem;
  }

  .cta-buttons {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta-button {
    padding: 1rem 2.5rem;
    text-decoration: none;
    font-family: var(--font-heading);
    font-weight: 600;
    letter-spacing: 0.05em;
    transition: all 0.3s ease;
    border: 2px solid var(--color-primary);
    background: var(--color-primary);
    color: var(--color-bg);
    font-size: 0.95rem;
  }

  .cta-button:hover {
    background: transparent;
    color: var(--color-primary);
  }

  .cta-button.secondary {
    background: transparent;
    color: var(--color-primary);
  }

  .cta-button.secondary:hover {
    background: var(--color-primary);
    color: var(--color-bg);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .about-container {
      padding: 1.5rem 1rem;
    }

    .about-header h1 {
      font-size: 2.5rem;
    }

    .header-subtitle {
      font-size: 1.05rem;
    }

    section h2 {
      font-size: 1.7rem;
    }

    .job-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.3rem;
    }

    .do-grid {
      grid-template-columns: 1fr;
    }

    .cta-section {
      padding: 2.5rem 1.5rem;
    }

    .cta-buttons {
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
    }
  }
</style>

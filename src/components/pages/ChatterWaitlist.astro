---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChatterDetails from '../ChatterDetails.astro';
import ChatterProductViews from '../ChatterProductViews.astro';
import { getChatterWaitlistContent } from '../../i18n/content/chatterWaitlist';
import type { Lang } from '../../i18n/ui';
export interface Props { lang: Lang; }
const { lang } = Astro.props;
const c = getChatterWaitlistContent(lang);
const values = [
  [c.value1Title, c.value1Text], [c.value2Title, c.value2Text],
  [c.value3Title, c.value3Text], [c.value4Title, c.value4Text],
];
---
<BaseLayout title={c.metaTitle} description={c.metaDescription} image="/images/blog/chatter-closed-alpha.webp" type="website" localized quiet>
  <div class="chatter-page">
    <section class="hero" aria-labelledby="chatter-title">
      <div class="hero-copy">
        <p class="name"><span class="conversation-mark" aria-hidden="true"></span>Chatter <span class="status">{c.eyebrow}</span></p>
        <h1 id="chatter-title">{c.heroH1a.replace(/\.$/, '')}</h1>
        <p class="lead">{c.heroLead}</p>
        <a href="#inside-chatter" class="primary-link">{c.heroCta}<span aria-hidden="true">↓</span></a>
        <p class="author">{c.formNote}</p>
      </div>
      <ChatterProductViews compact />
    </section>
    <ul class="values" aria-label="Chatter features">
      {values.map(([title, text]) => <li><strong>{title}</strong><span>{text}</span></li>)}
    </ul>
    <ChatterDetails lang={lang} />
    <section class="privacy-summary">
      <h2>{c.statementH2a}{c.statementH2b}</h2>
      <p>{c.statementP}</p>
    </section>
    <section class="closing">
      <div><h2>{c.techTitle}</h2><p>{c.techP}</p></div>
      <div class="closing-links">
        <a href="/blog/chatter-closed-alpha-rust-slint-messenger" set:html={c.techLink}></a>
        <a href="mailto:alexpruteanu@hotmail.com?subject=Chatter%20alpha">{c.githubCta} →</a>
      </div>
    </section>
  </div>
</BaseLayout>
<style>
  .chatter-page { max-width: 1120px; margin: 0 auto; }
  .hero { display: grid; grid-template-columns: .85fr 1.15fr; gap: 64px; align-items: center; padding: 32px 0 64px; }
  .name { display: flex; gap: 12px; align-items: center; font-size: 20px; font-weight: 500; margin-bottom: 32px; color: #edf0ee; }
  .conversation-mark { display: inline-block; width: 16px; height: 12px; border: 1.5px solid #8ed5bd; border-radius: 4px 4px 4px 0; }
  .status { font-size: 13px; color: #a2aaa7; font-weight: 400; margin-left: 4px; }
  h1 { font-size: clamp(40px, 4.5vw, 60px); font-weight: 500; line-height: 1.08; letter-spacing: -.04em; margin-bottom: 24px; color: #edf0ee; }
  .lead { font-size: 18px; line-height: 1.7; color: #b4bcb8; margin-bottom: 32px; }
  .primary-link { display: inline-flex; align-items: center; gap: 32px; padding: 12px 20px; border-radius: 8px; color: #111415; background: #edf0ee; text-decoration: none; font-size: 15px; font-weight: 500; transition: background .16s ease-out; }
  .primary-link:hover { background: #cdd9d2; }
  .author { color: #a2aaa7; font-size: 13px; margin-top: 20px; }
  .values { display: grid; grid-template-columns: repeat(4, 1fr); list-style: none; padding: 32px 0; border-top: 1px solid #ffffff14; border-bottom: 1px solid #ffffff14; gap: 32px; }
  .values li { display: flex; flex-direction: column; gap: 8px; }
  .values strong { font-size: 15px; color: #edf0ee; font-weight: 500; }
  .values span { color: #a2aaa7; font-size: 14px; line-height: 1.6; }
  .privacy-summary, .closing { max-width: 820px; margin: 64px auto 0; padding-top: 40px; border-top: 1px solid #ffffff14; }
  h2 { color: #edf0ee; font-size: 28px; line-height: 1.3; font-weight: 500; letter-spacing: -.025em; margin-bottom: 20px; }
  .privacy-summary p, .closing p { color: #b4bcb8; line-height: 1.8; font-size: 17px; }
  .closing-links { display: flex; flex-wrap: wrap; gap: 32px; margin-top: 24px; }
  .closing a { color: #8ed5bd; text-underline-offset: 4px; font-size: 15px; }
  @media (max-width: 900px) { .hero { gap: 32px; grid-template-columns: 1fr 1fr; } .values { gap: 24px; grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .hero { grid-template-columns: 1fr; padding: 16px 0 40px; gap: 32px; } .name { margin-bottom: 24px; } .lead { font-size: 17px; } .values { gap: 24px; padding: 24px 0; } }
</style>
